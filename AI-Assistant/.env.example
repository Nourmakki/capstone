# Copy this to .env and fill in the key. .env is gitignored - never commit it.

# This assistant's own Gemini key, from https://aistudio.google.com/apikey
#
# Deliberately not the one in AI-System/.env. Two services on one key share
# a rate limit, so a burst of roadmap generation would start failing the
# assistant's answers, and neither side's usage could be told apart.
GEMINI_API_KEY=

# Where the platform's API lives, for reading the catalogue to index.
LARAVEL_API_URL=http://127.0.0.1:8000/api

# A token for that API, so indexing can read manager-visible content.
LARAVEL_API_TOKEN=

# Where Chroma keeps the index on disk.
CHROMA_PATH=./chroma_persist
